# Copie este arquivo para mobile/.env e preencha com os dados do seu projeto.
# Supabase > Project Settings > Data API
#
# Estas duas variaveis sao embutidas no APK e, por isso, publicas. Tudo bem:
# a chave anon so consegue ler o que as policies de RLS permitirem, e quem nao
# tiver uma linha em `profiles` nao enxerga nada.
#
# As credenciais da Pluggy NAO ficam aqui. Elas vivem nos secrets da Edge
# Function (veja o README).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
